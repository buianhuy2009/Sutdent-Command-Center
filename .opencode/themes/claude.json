{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "paper": "#F5F0E6",
    "paperPanel": "#EAE2D1",
    "paperElement": "#E0D5BE",
    "ink": "#26241F",
    "inkMuted": "#7A7161",
    "claude": "#D97757",
    "claudeDeep": "#B85C38",
    "gold": "#C99A2E",
    "sage": "#6C9A6D",
    "clay": "#B3402E",
    "amber": "#C08A1D",
    "slate": "#64748B",
    "borderLight": "#D5C9AF",
    "borderLightSubtle": "#E2D8C0",
    "coal": "#201D18",
    "coalPanel": "#2B2620",
    "coalElement": "#38312A",
    "cream": "#ECE3D0",
    "creamMuted": "#A2937B",
    "coralBright": "#E8936B",
    "goldBright": "#E0B44C",
    "borderDark": "#4A4136",
    "borderDarkSubtle": "#38312A"
  },
  "theme": {
    "primary": { "dark": "coralBright", "light": "claude" },
    "secondary": { "dark": "claudeDeep", "light": "claudeDeep" },
    "accent": { "dark": "goldBright", "light": "gold" },
    "error": { "dark": "coralBright", "light": "clay" },
    "warning": { "dark": "goldBright", "light": "amber" },
    "success": { "dark": "sage", "light": "sage" },
    "info": { "dark": "slate", "light": "slate" },
    "text": { "dark": "cream", "light": "ink" },
    "textMuted": { "dark": "creamMuted", "light": "inkMuted" },
    "background": { "dark": "coal", "light": "paper" },
    "backgroundPanel": { "dark": "coalPanel", "light": "paperPanel" },
    "backgroundElement": { "dark": "coalElement", "light": "paperElement" },
    "border": { "dark": "borderDark", "light": "borderLight" },
    "borderActive": { "dark": "coralBright", "light": "claude" },
    "borderSubtle": { "dark": "borderDarkSubtle", "light": "borderLightSubtle" },
    "diffAdded": { "dark": "sage", "light": "sage" },
    "diffRemoved": { "dark": "clay", "light": "clay" },
    "diffContext": { "dark": "creamMuted", "light": "inkMuted" },
    "diffHunkHeader": { "dark": "creamMuted", "light": "inkMuted" },
    "diffHighlightAdded": { "dark": "sage", "light": "sage" },
    "diffHighlightRemoved": { "dark": "clay", "light": "clay" },
    "diffAddedBg": { "dark": "coalPanel", "light": "paperPanel" },
    "diffRemovedBg": { "dark": "coalPanel", "light": "paperPanel" },
    "diffContextBg": { "dark": "coalPanel", "light": "paperPanel" },
    "diffLineNumber": { "dark": "borderDark", "light": "borderLight" },
    "diffAddedLineNumberBg": { "dark": "coalPanel", "light": "paperPanel" },
    "diffRemovedLineNumberBg": { "dark": "coalPanel", "light": "paperPanel" },
    "markdownText": { "dark": "cream", "light": "ink" },
    "markdownHeading": { "dark": "coralBright", "light": "claudeDeep" },
    "markdownLink": { "dark": "goldBright", "light": "gold" },
    "markdownLinkText": { "dark": "coralBright", "light": "claude" },
    "markdownCode": { "dark": "goldBright", "light": "claudeDeep" },
    "markdownBlockQuote": { "dark": "creamMuted", "light": "inkMuted" },
    "markdownEmph": { "dark": "goldBright", "light": "gold" },
    "markdownStrong": { "dark": "coralBright", "light": "claudeDeep" },
    "markdownHorizontalRule": { "dark": "borderDark", "light": "borderLight" },
    "markdownListItem": { "dark": "cream", "light": "ink" },
    "markdownListEnumeration": { "dark": "goldBright", "light": "gold" },
    "markdownImage": { "dark": "goldBright", "light": "gold" },
    "markdownImageText": { "dark": "coralBright", "light": "claude" },
    "markdownCodeBlock": { "dark": "cream", "light": "ink" },
    "syntaxComment": { "dark": "creamMuted", "light": "inkMuted" },
    "syntaxKeyword": { "dark": "coralBright", "light": "claudeDeep" },
    "syntaxFunction": { "dark": "goldBright", "light": "gold" },
    "syntaxVariable": { "dark": "cream", "light": "ink" },
    "syntaxString": { "dark": "sage", "light": "sage" },
    "syntaxNumber": { "dark": "goldBright", "light": "amber" },
    "syntaxType": { "dark": "goldBright", "light": "gold" },
    "syntaxOperator": { "dark": "coralBright", "light": "claude" },
    "syntaxPunctuation": { "dark": "creamMuted", "light": "inkMuted" }
  }
}
