# === Student Command Center — Environment Variables ===
# Copy this file to .env and fill values. All VITE_ vars are exposed to client.

# --- Gemini AI (server + client fallback) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"          # Server-side fallback (Vercel env)
VITE_GEMINI_MODEL=gemini-2.0-flash          # Optional override
GROQ_API_KEY="gsk_..."                      # Optional: Groq LLaMA 3.3 70B fallback

# --- App Host ---
APP_URL="MY_APP_URL"                        # Vercel URL, e.g. https://student-command-center.vercel.app
VITE_APP_URL="https://student-command-center.vercel.app"
VITE_GOOGLE_PROJECT_ID=614024702267         # Google Cloud Project ID/Number (replaces hardcoded 614024702267)
CANVAS_ALLOWED_HOSTS=instructure.com,canvaslms.com  # Proxy allowlist

# --- Firebase (client — Vite) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Vercel helpers (auto-set)
# VERCEL_URL= (auto)
# NODE_ENV=production
